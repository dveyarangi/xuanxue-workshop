{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --offline --no-project python .agents/scripts/gw/questions.py --hook codex",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --offline --no-project python .agents/scripts/gw/questions.py --hook codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --offline --no-project python .agents/scripts/gw/questions.py --hook codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
